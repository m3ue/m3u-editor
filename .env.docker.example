# Build
LOCAL_BUILD=true
IMAGE_TAG=local

# Gluetun
#SERVER_COUNTRIES=
#VPN_SERVICE_PROVIDER=
#WIREGUARD_PRIVATE_KEY=
#WIREGUARD_ADDRESSES=
#SERVER_HOSTNAMES=

# Config variables
#FPMPORT=9000

#REDIS_HOST=m3u-editor-redis
#REDIS_SERVER_PORT=36790

M3U_PROXY_TOKEN=changeme
M3U_PROXY_HOST=localhost
M3U_PROXY_PORT=38085

# For embedded proxy
#M3U_PROXY_REPO=https://github.com/sparkison/m3u-proxy.git
#M3U_PROXY_BRANCH=dev

PG_PORT=5432
PG_DATABASE=m3ue
PG_USER=m3ue
PG_PASSWORD=m3ue

# Embedded Postgres major version. Default is 17. Set to 18 and restart to
# upgrade your existing data directory in place - needs roughly the current
# database's size free on disk, and the 17 cluster is kept (not deleted) so
# you can still roll back. Never auto-detected.
#POSTGRES_VERSION=18

# Rolls back to an older POSTGRES_VERSION after a completed upgrade. This is
# a real downgrade: data written since the upgrade is not carried back.
# Without this set to true, lowering POSTGRES_VERSION alone is ignored.
#POSTGRES_ROLLBACK=false

# PostgreSQL client tools version used for backup/restore (pg_dump/psql).
# Defaults to whatever POSTGRES_VERSION is set to; only needs setting by
# hand when connecting to an external server on a different major.
#PG_CLIENT_VERSION=18

# SQLite → PostgreSQL one-time data migration.
# Set to true alongside DB_CONNECTION=pgsql to copy your existing SQLite data to Postgres on next start.
# Safe to leave as true after migration — runs once, then skips via a flag file.
# A backup of database.sqlite is created in ./data/database/backups/ before migrating.
#SQLITE_MIGRATE=false
